# 安仔记忆系统 v3.0 环境配置
# 复制为 .env 并修改

# 数据存储路径
DATA_DIR=./data

# Hugging Face 镜像配置（国内加速）
# 默认使用 hf-mirror.com，如需官方源请注释或删除
HF_ENDPOINT=https://hf-mirror.com

# Embedding模型配置
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_MODEL=BAAI/bge-m3  # 高性能备选

# 向量数据库配置
VECTOR_DB_PATH=./data/vector_db

# 测试模式（解决 Windows 文件锁定问题）
# 设置 TEST_MODE=true 使用内存模式（数据不持久化）
# 设置 TEST_MODE=false 使用持久化模式（生产环境）
TEST_MODE=false

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 记忆分层配置
WORK_MEMORY_HOURS=24
SHORT_TERM_DAYS=7
MID_TERM_DAYS=30
LONG_TERM_DAYS=365
